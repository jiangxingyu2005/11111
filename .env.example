# MinerU(跑在 Docker 容器,映射端口;v1 协议)
MINERU_API_BASE_URL=http://127.0.0.1:8008
MINERU_API_PREFIX=/v1
MINERU_TIMEOUT=600             # 单次 HTTP 请求超时(秒)
MINERU_POLL_INTERVAL=2         # 轮询任务状态间隔(秒)
MINERU_MAX_WAIT_SECONDS=1800   # 等待任务完成的最大时长(秒)
MINERU_OUTPUT_FORMATS=markdown,middle_json   # 逗号分隔;可选 markdown/middle_json/html/latex/docx/zip
MINERU_TIER=                   # 可选 flash/basic/standard/advanced,留空用默认
MINERU_OCR_MODE=auto           # auto/txt/ocr

# 本服务
UPLOAD_DIR=./uploads
OUTPUT_DIR=./output
MAX_UPLOAD_MB=50

# ASR(音频转文字,faster-whisper 本地模型)
ASR_MODEL_SIZE=small        # 模型大小:tiny/base/small/medium/large-v3
ASR_MODEL_DIR=./model       # 模型本地目录(单独 model 文件夹)
ASR_DEVICE=cpu              # 推理设备:cpu / cuda
ASR_COMPUTE_TYPE=int8       # 计算精度:int8(CPU 推荐)/ float16 / float32
ASR_LANGUAGE=zh             # 识别语言,留空则自动检测

# BLIP(图片语义理解,transformers 本地模型;BLIP2 内存不足改用 BLIP-base)
BLIP_MODEL_ID=Salesforce/blip-image-captioning-base   # 模型仓库 id
BLIP_MODEL_DIR=./model/blip                            # 模型本地目录(单独 blip 文件夹)
BLIP_MAX_NEW_TOKENS=60                                 # 生成 caption 的最大 token 数

# 翻译(英文→中文,MarianMT 本地模型,把 BLIP 英文 caption 翻成中文)
TRANSLATOR_MODEL_ID=Helsinki-NLP/opus-mt-en-zh   # 模型仓库 id
TRANSLATOR_MODEL_DIR=./model/mt-en-zh            # 模型本地目录(单独文件夹)
TRANSLATOR_MAX_NEW_TOKENS=128                    # 翻译生成的最大 token 数

# 视频(抽帧 -> 每帧走图片提取链路)
VIDEO_FRAME_RATE=2.0                   # 每秒抽帧数
VIDEO_MAX_FRAMES=60                    # 最大处理帧数(去重后仍超则均匀采样)
VIDEO_FRAME_SIMILARITY_THRESHOLD=0.95  # 相邻帧相似度阈值,>= 此值判为相似跳过

# HTML(上传 HTML 文件 -> 提取正文)
HTML_NOISE_TAGS=script,style,noscript,iframe,nav,footer,header,aside,form   # 逗号分隔的去除标签

# IQ 信号(H5 上传 -> SNR 清洗 -> IQ 补全 -> 信号处理 -> 26 特征)
IQ_SEGMENT_LEN=128                    # IQ 片段长度(SNR/embed/分类统一分段长度)
IQ_SNR_THRESHOLD_DB=-10.0             # SNR 阈值(dB),低于此值的片段剔除
IQ_TARGET_FS=10000000                 # 重采样目标采样率(Hz),10MHz
IQ_MODEL_DIR=model/iq                 # IQ 模型目录(单独 iq 文件夹)
IQ_XGB_MODEL_PATH=model/iq/xgb_15class.json
IQ_CNN_MODEL_PATH=model/iq/cnn_15class_full.pth
IQ_LABEL_MAP_PATH=model/iq/label_map_15.json
IQ_BUQUAN_MODEL_PATH=model/iq/best.pth

# 清洗(页眉/页脚判定参数)
CLEAN_HEADER_THRESHOLD=3        # 短文本重复多少次判为页眉/页脚
CLEAN_HEADER_MAX_LEN=60         # 页眉/页脚候选文本的最大长度

# 打分(文本质量评分阈值与权重)
SCORE_MIN_CHUNK_LEN=20          # 长度维度下界(字符),块短于此则长度分记 0
SCORE_MAX_CHUNK_LEN=512         # 长度维度上界(字符),块长于此则长度分记满
SCORE_Q_QUARANTINE=0.4          # 质量分隔离阈值,低于此分不分级保留
SCORE_Q_KEEP=0.6                # 质量分保留阈值,高于此分按高权重
SCORE_W_LEN=0.25                # 长度维度权重
SCORE_W_INFO=0.30               # 信息密度维度权重
SCORE_W_CONTENT=0.25            # 内容词占比维度权重
SCORE_W_HITS=0.20               # 参数实体命中维度权重

# MinIO 对象存储(S3 兼容;Web 控制台 http://localhost:9001)
MINIO_ENDPOINT=http://localhost:9000    # S3 API 地址(程序连接用)
MINIO_ACCESS_KEY=minioadmin             # 访问密钥
MINIO_SECRET_KEY=minioadmin             # 访问私钥
MINIO_RAW_BUCKET=qingxi-raw             # 源文件桶(原始上传文件)
MINIO_CLEAN_BUCKET=qingxi-clean         # 清洗后文件桶(clean 结果)
MINIO_SECURE=false                      # 是否 https(http 为 false)

# PostgreSQL(pgvector 扩展,向量存储;宿主机 5434 → 容器 5432)
POSTGRES_HOST=localhost                 # 主机
POSTGRES_PORT=5434                      # 端口(宿主机映射)
POSTGRES_USER=postgres                  # 用户
POSTGRES_PASSWORD=postgres              # 密码
POSTGRES_DATABASE=postgres              # 数据库名

# GraphRAG(ems_graphrag 融合:清洗 md -> PG 父/子块 -> Milvus -> Neo4j)
GRAPHRAG_ENABLED=true                   # 是否在清洗完自动入图谱(IQ 不入)

# Milvus 向量库(子块 1024 维向量)
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=ems_chunks
MILVUS_DIM=1024

# Neo4j 图库(实体/父块/关系)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword             # neo4j_test 容器的实际密码(NEO4J_AUTH=neo4j/testpassword)

# Kafka(CDC 实时增量,Phase 3 用)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ems.public.parent_document
KAFKA_GROUP_ID=ems_cdc_group

# 切分(父块按 H1-H3 / 子块固定字符 + 比例重叠)
GRAPHRAG_CHUNK_SIZE=512
GRAPHRAG_CHUNK_OVERLAP=0.10

# 嵌入(mock = 确定性哈希向量;openai = text-embedding-3-large;bge = 本地 FlagEmbedding)
GRAPHRAG_EMBEDDING_PROVIDER=mock
# bge 时填 BAAI/bge-m3 或 BAAI/bge-large-zh-v1.5(均 1024 维,需 pip install FlagEmbedding)
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-large
GRAPHRAG_EMBEDDING_DIM=1024
GRAPHRAG_EMBEDDING_BATCH_SIZE=64
# bge 本地设备:空 = 自动,cuda/cpu;半精度(有 GPU 可 true 省显存,CPU 建议 false)
GRAPHRAG_EMBEDDING_DEVICE=
GRAPHRAG_EMBEDDING_USE_FP16=false

# LLM(mock = 确定性正则抽取,openai/qwen = function calling)
# qwen = 国产模型,本地 vLLM 起 OpenAI 兼容端点,数据不出网:
#   GRAPHRAG_LLM_PROVIDER=qwen
#   GRAPHRAG_LLM_BASE_URL=http://<内网host>:8000/v1
#   GRAPHRAG_LLM_API_KEY=EMPTY(或 vLLM 启动时的 --api-key token)
#   GRAPHRAG_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct(显存不足用 32B/14B;function calling 需 14B+)
GRAPHRAG_LLM_PROVIDER=mock
GRAPHRAG_LLM_BASE_URL=https://api.openai.com/v1
GRAPHRAG_LLM_API_KEY=
GRAPHRAG_LLM_MODEL=gpt-4o
GRAPHRAG_LLM_TEMPERATURE=0.0
GRAPHRAG_LLM_MAX_TOKENS=4096
GRAPHRAG_LLM_MAX_RETRIES=2

# 图抽取置信度三档分流
GRAPHRAG_CONFIDENCE_HIGH=0.9
GRAPHRAG_CONFIDENCE_LOW=0.6
GRAPHRAG_TAU_A=0.6
GRAPHRAG_TAU_B=0.9

# 在线查询(链路 C)
GRAPHRAG_QUERY_TOPK=10
GRAPHRAG_QUERY_RERANK_TOPK=5
GRAPHRAG_QUERY_EXPAND_DEPTH=2
GRAPHRAG_QUERY_ENTITY_BOOST_WEIGHT=0.15

# 路由(离线/实时分流阈值)
GRAPHRAG_ROUTE_FILE_SIZE_MB=10
GRAPHRAG_ROUTE_BATCH_COUNT=5

# 消歧(实体归一对齐;enabled=false 关闭后行为回到 Phase 4)
GRAPHRAG_RESOLVE_ENABLED=true
GRAPHRAG_RESOLVE_FINGERPRINT=true
GRAPHRAG_RESOLVE_VECTOR_ENABLED=true
GRAPHRAG_RESOLVE_SIM_HIGH=0.62   # 自动并阈值(bge-large-zh-v1.5 实测校准;换 openai/其他模型需重校准)
GRAPHRAG_RESOLVE_SIM_LOW=0.55    # 灰区下界
GRAPHRAG_RESOLVE_LLM_GATE=false
GRAPHRAG_RESOLVE_TOPK=5
GRAPHRAG_ENTITY_COLLECTION=ems_entities

# 漏抽质检门禁(入库质检 + /graph/quality 健康度;默认值待真实数据校准)
GRAPHRAG_QUALITY_ENTITY_CHUNK_RATIO=0.2
GRAPHRAG_QUALITY_MAX_ORPHAN_RATE=0.5
GRAPHRAG_QUALITY_MIN_BINDS_COVERAGE=0.3
GRAPHRAG_QUALITY_MAX_EMPTY_RATIO=0.5
