# Compose 内网地址（覆盖本机 .env 里的 localhost）
NACOS_ENABLED=false

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=ems_chunks
MILVUS_DIM=1024

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_RAW_BUCKET=qingxi-raw
MINIO_CLEAN_BUCKET=qingxi-clean
MINIO_SECURE=false

MINERU_API_BASE_URL=http://mineru:8000
MINERU_API_PREFIX=/v1

UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/output
ASR_MODEL_DIR=/app/model
BLIP_MODEL_DIR=/app/model/blip
TRANSLATOR_MODEL_DIR=/app/model/mt-en-zh
IQ_MODEL_DIR=/app/model/iq

GRAPHRAG_ENABLED=true
GRAPHRAG_EMBEDDING_PROVIDER=bge
GRAPHRAG_EMBEDDING_MODEL=/app/model/bge-m3
GRAPHRAG_EMBEDDING_DIM=1024
GRAPHRAG_EMBEDDING_DEVICE=cpu
GRAPHRAG_EMBEDDING_USE_FP16=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# LLM 不在此覆盖，沿用仓库根 .env（DeepSeek / openai 兼容）

# 跨文档消歧 ③:向量候选须经 LLM 双向判同才合并
GRAPHRAG_RESOLVE_LLM_GATE=true
