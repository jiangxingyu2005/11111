# ============================================================
# retrieval 服务 .env —— 真实链路(复用 qingxi 现有三库容器,独立命名空间)
# 不另起 docker-compose:PG 建独立库 retrieval、Milvus 建独立集合、
# Neo4j 用 seed 专属 scope,均不冲掉 qingxi 现有数据。
# ============================================================

# ---- 三库连接(指向 qingxi 现有容器)----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=retrieval

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_CHUNK_COLLECTION=retrieval_chunks
MILVUS_ENTITY_COLLECTION=retrieval_entities

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword

# ---- 模型端点(真 BGE-M3,由 model_stub 进程内加载)----
RETRIEVAL_EMBED_MODE=remote
RETRIEVAL_EMBED_URL=http://model_stub:8010/embed
GRAPHRAG_EMBEDDING_MODEL=BAAI/bge-m3

GRAPHRAG_LLM_BASE_URL=https://api.deepseek.com/v1
GRAPHRAG_LLM_API_KEY=sk-6c352d8eb890461db8a988f26d706750
GRAPHRAG_LLM_MODEL=deepseek-chat

RETRIEVAL_RERANK_SERVICE_URL=http://model_stub:8010/rerank

# ---- 功能开关 ----
RETRIEVAL_BM25_ENABLED=false
MEMORY_ENABLED=true
RETRIEVAL_GRAPH_ROUTE_ENABLED=true
RETRIEVAL_COMMUNITY_ENABLED=false

# ---- 后端通道 ----
RETRIEVAL_BACKEND=real

# ===== Nacos 配置中心(全量迁入后,本地 .env 只保留这一段)=====
