FROM docker.m.daocloud.io/library/python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    MINERU_MODEL_SOURCE=modelscope

WORKDIR /opt/mineru

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl libgl1 libglib2.0-0 gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip install -U pip -i https://pypi.tuna.tsinghua.edu.cn/simple \
 && pip install "mineru>=4.0,<5" -i https://pypi.tuna.tsinghua.edu.cn/simple

EXPOSE 8000

HEALTHCHECK --interval=20s --timeout=8s --start-period=180s --retries=30 \
  CMD curl -fsS http://127.0.0.1:8000/v1/health || exit 1

CMD ["mineru-kit", "api-server", "--host", "0.0.0.0", "--port", "8000"]
