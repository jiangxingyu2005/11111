# ===== Nacos 配置中心（Docker 内网 bootstrap，覆盖仓库 retrieval/.env 里的 127.0.0.1）=====
# 注意：model_stub 的 _read_bootstrap_env() 只读 retrieval/.env 文件、不读 os.environ，
# 所以此处必须在构建时 COPY 到 /app/retrieval/.env，不能只靠 compose environment。
NACOS_ENABLED=true
NACOS_SERVER_ADDR=http://nacos:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_DATA_IDS=retrieval.env,retrieval.yaml,query_parser.yaml,relations.yaml
