FROM docker.m.daocloud.io/library/python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120

WORKDIR /app/retrieval

RUN apt-get update && apt-get install -y --no-install-recommends curl gcc \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/requirements.retrieval.txt /tmp/retrieval-requirements.txt
RUN pip install -U pip -i https://pypi.tuna.tsinghua.edu.cn/simple \
 && pip install -r /tmp/retrieval-requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

COPY common /app/common
COPY retrieval /app/retrieval

# Nacos bootstrap 指向 compose 内网 nacos 服务（覆盖仓库 retrieval/.env 的 127.0.0.1）
COPY deploy/retrieval.docker.env /app/retrieval/.env

EXPOSE 8100

HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=10 \
  CMD curl -fsS http://127.0.0.1:8100/healthz || exit 1

CMD ["sh", "-c", "python scripts/gen_seed.py --embed service --embed-url http://model_stub:8010/embed && exec uvicorn app.main:app --host 0.0.0.0 --port 8100"]
