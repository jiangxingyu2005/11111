# ============================================================
# retrieval 服务 .env 模板（CI 契约测试输入）
# 纪律：① 缺必需变量拒绝启动，禁止带默认值静默启动
#       ② 算法参数以 config/*.yaml 为准，env 只做部署级覆盖
#       ③ 三库账号必须只读（IF-9），写操作全拒为验收条件
# ============================================================

# ---- 三库连接（全部填只读账号，IF-9）----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=retrieval_ro
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=qingxi

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_CHUNK_COLLECTION=ems_chunks
MILVUS_ENTITY_COLLECTION=ems_entities

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=retrieval_ro
NEO4J_PASSWORD=change_me

# ---- 模型端点 ----
# query 向量化：local=本地 FlagEmbedding（需自行安装）/ remote=嵌入服务端点
RETRIEVAL_EMBED_MODE=remote
RETRIEVAL_EMBED_URL=http://127.0.0.1:8001/embed
# 与离线侧同模型同空间（定案 BGE-M3 全量替代，dense 1024 维；sparse 随 IF-1 扩列启用）
GRAPHRAG_EMBEDDING_MODEL=BAAI/bge-m3

# LLM（QRY-02 L2 / RPT 生成，vLLM OpenAI 兼容端点）
GRAPHRAG_LLM_BASE_URL=http://127.0.0.1:9000/v1
GRAPHRAG_LLM_API_KEY=EMPTY
GRAPHRAG_LLM_MODEL=qwen2.5-14b-instruct

# Rerank 服务（bge-reranker-v2-m3，TEI/vLLM）
RETRIEVAL_RERANK_SERVICE_URL=http://127.0.0.1:8002/rerank

# ---- 接入自有模型（不想改 yaml 就在这里覆盖，优先级高于 yaml）----
# 三类能力 × 三个变量即可接完：BACKEND / URL / MODEL（+ 可选 API_KEY）
# 自研服务再补 *_REQUEST / *_RESPONSE 的字段路径 JSON，例：
#   EMBED_REQUEST={"texts_key":"sentences"}   EMBED_RESPONSE={"dense":"vectors.*"}
EMBED_BACKEND=bge_m3              # hash | bge_m3 | openai | generic
EMBED_URL=                        # openai 协议填到 /v1（会自动拼 /embeddings）；generic 填完整路径
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
EMBED_PRESET=                     # tei_embed / ollama_embed / openai_embed / local_bge_m3

RERANK_BACKEND=bge                # hash | bge | generic
RERANK_URL=                       # generic 填完整路径，如 http://tei:8080/rerank
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_PRESET=                    # tei_rerank / siliconflow_rerank / local_bge_reranker

LLM_BACKEND=openai                # echo | openai | hf | generic
LLM_URL=http://vllm-gpu-box:9000/v1
LLM_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=EMPTY

# ---- 模型契约逃生阀（默认 0）----
# real 通道 + 占位模型默认拒绝启动：宁可停机，不许"召回全是噪声还报绿"
RETRIEVAL_ALLOW_PLACEHOLDER=0

# ---- 功能开关 ----
# ② 路外置 BM25（消融 D2 裁决前默认关）
RETRIEVAL_BM25_ENABLED=false
RETRIEVAL_BM25_URL=
# 空 = FAQ pass-through（IF-7 已确认推迟）
RETRIEVAL_REDIS_URL=
# ③-A 图遍历开关
RETRIEVAL_GRAPH_ROUTE_ENABLED=true
# ③-B 社区摘要路（IF-4 deferred，暂不开）
RETRIEVAL_COMMUNITY_ENABLED=false

# ---- 记忆管理（多人隔离 + 会话多轮 + mem0 长期事实；算法参数以 config/retrieval.yaml 的 memory 段为准）----
# 注意：开启后 retrieval 由「三库只读」变为对 conversations/messages 两张新表读写，
#      需给 retrieval 账号授予这两张表的写权限（IF-9 只读约束仅覆盖三库本体）。
MEMORY_ENABLED=false                  # 总开关，默认关（不影响现有部署与既有用例）
MEMORY_AUTH_MODE=passthrough          # passthrough（token 即 user_id，内网/测试）/ jwt（验签，sub=user_id）
MEMORY_JWT_SECRET=                    # jwt 模式验签密钥（≥32 字节；passthrough 模式留空）

# ---- 检索参数（部署级覆盖；算法基准以 config/retrieval.yaml 为准）----
RETRIEVAL_BUDGET_TOTAL_MS=5200

# ---- TRACE 导出（file/kafka/http 三选一，EV-2）----
RETRIEVAL_TRACE_EXPORT=file
RETRIEVAL_TRACE_DIR=logs/trace

# ---- 权限（R4：scope 从第一行代码就是必填，无默认值）----
# 请求体必带 scope；服务侧校验两次（检索过滤 + 图谱接口）

# ---- 开发模式 ----
